# 使用国内镜像源的 Dockerfile（如果 Docker Hub 无法访问）
# 使用方法：复制此文件覆盖 Dockerfile，或重命名为 Dockerfile

# 使用阿里云镜像（如果可用）
# FROM registry.cn-hangzhou.aliyuncs.com/acs/python:3.10-slim

# 或者使用中科大镜像
FROM docker.mirrors.ustc.edu.cn/library/python:3.10-slim

# 设置工作目录
WORKDIR /app

# 设置环境变量
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DEBIAN_FRONTEND=noninteractive \
    DOCKER_ENV=1

# 配置 pip 使用国内镜像源（加速 Python 包安装）
RUN pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple && \
    pip config set global.trusted-host pypi.tuna.tsinghua.edu.cn

# 安装系统依赖（用于matplotlib中文字体支持）
RUN apt-get update && apt-get install -y \
    build-essential \
    libgomp1 \
    fonts-wqy-zenhei \
    fonts-wqy-microhei \
    && rm -rf /var/lib/apt/lists/*

# 复制requirements文件
COPY requirements.txt .

# 安装Python依赖
RUN pip install --no-cache-dir -r requirements.txt

# 复制应用代码
COPY XGBoost2pre.py .

# 创建必要的输出目录
RUN mkdir -p /app/output/{saved_models,preprocessors,feature_correlations,feature_importance,learning_curves,train_metrics,test_metrics,test_results} \
    && mkdir -p /app/dataset \
    && mkdir -p /app/validate_ds

# 设置matplotlib使用中文字体
RUN python -c "import matplotlib; print(matplotlib.get_cachedir())" && \
    python -c "import matplotlib.pyplot as plt; plt.rcParams['font.sans-serif'] = ['WenQuanYi Zen Hei', 'WenQuanYi Micro Hei', 'DejaVu Sans']"

# 默认命令
CMD ["python", "XGBoost2pre.py", "--help"]

